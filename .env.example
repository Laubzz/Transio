# Comptes utilisateurs (Supabase). Par défaut, le projet Supabase de Transio (src/lib/config.ts).
# Renseigner ces valeurs pour pointer vers un autre projet.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# « off » désactive les comptes : données gardées dans le navigateur (tests, hors ligne).
NEXT_PUBLIC_ACCOUNTS=

# Strava (https://www.strava.com/settings/api) : sans ces valeurs, l'import Strava est masqué.
NEXT_PUBLIC_STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
