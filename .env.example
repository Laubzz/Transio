# Comptes utilisateurs (Supabase) : sans ces deux valeurs, l'app fonctionne sans compte,
# avec les données gardées dans le navigateur.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Strava (https://www.strava.com/settings/api) : sans ces valeurs, l'import Strava est masqué.
NEXT_PUBLIC_STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
